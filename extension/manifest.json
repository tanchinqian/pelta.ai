{
  "manifest_version": 3,
  "name": "pelta.ai Prompt Guard",
  "version": "1.0",
  "description": "Intercepts ChatGPT prompts and checks them against pelta.ai's governance API before they are sent.",
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "pelta.ai Prompt Guard"
  },
  "permissions": ["storage", "clipboardRead", "tabs", "notifications"],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://copilot.microsoft.com/*",
    "http://localhost:3000/*",
    "https://peltaai-production.up.railway.app/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://gemini.google.com/*",
        "https://claude.ai/*",
        "https://chat.deepseek.com/*",
        "https://deepseek.com/*",
        "https://copilot.microsoft.com/*"
      ],
      "js": ["content-script.js"],
      "css": ["overlay.css"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["tesseract.esm.min.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
