# ==============================================================================
# Pelta.ai — Environment Configuration Template
# Real-Time AI Governance & Prompt-Level DLP Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LLM & Google Gemini API Credentials
# ------------------------------------------------------------------------------
# Required for:
# - Automated AI Tool Risk Classification (NIST AI RMF 1.0 Aligned)
# - Contextual / Semantic Prompt-Risk Inspection (DLP Escalation)
# - Real-Time Safe Prompt Rewriting (3 Context-Aware Alternatives)
# - Multimodal Screenshot OCR Interception (Gemini Vision)
#
# Obtain a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Secondary / Fallback environment variable name for Gemini key
LLM_API_KEY=

# ------------------------------------------------------------------------------
# 2. Model Routing & Performance Tuning (Optional)
# ------------------------------------------------------------------------------
# Comma-separated list of Gemini models to query in priority order.
# Default cascade: gemini-3.5-flash-lite, gemini-flash-latest, gemini-3.5-flash, gemini-2.5-flash
# GEMINI_CLASSIFY_MODEL=gemini-2.5-flash,gemini-3.5-flash

# Maximum time in milliseconds to wait for LLM response before applying deterministic fallback
# Default: 12000 (12 seconds) for prompt check/classify; 20000 (20 seconds) for OCR
# LLM_TIMEOUT_MS=12000

# ------------------------------------------------------------------------------
# 3. Server Configuration (Optional)
# ------------------------------------------------------------------------------
# Port for the Next.js development and production server
PORT=3000
